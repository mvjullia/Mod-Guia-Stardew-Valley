<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>StardewRealtimeTelemetry</AssemblyName>
    <RootNamespace>StardewRealtimeTelemetry</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>pickaxe_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <!-- Pacote oficial que referencia automaticamente o Stardew Valley e a SMAPI -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../guia-stardew/dist/index.html" LogicalName="Guide.index.html" />
    <EmbeddedResource Include="../guia-stardew/dist/telemetry.js" LogicalName="Guide.telemetry.js" />
    <EmbeddedResource Include="../guia-stardew/dist/realtime.js" LogicalName="Guide.realtime.js" />
    <EmbeddedResource Include="../guia-stardew/dist/embedded.js" LogicalName="Guide.embedded.js" />
  </ItemGroup>
<ItemGroup><EmbeddedResource Include="../guia-stardew/dist/visual.js" LogicalName="Guide.visual.js" /></ItemGroup><ItemGroup><EmbeddedResource Include="../guia-stardew/dist/knowledge.js" LogicalName="Guide.knowledge.js" /></ItemGroup><ItemGroup><EmbeddedResource Include="../guia-stardew/dist/polish.js" LogicalName="Guide.polish.js" /></ItemGroup><ItemGroup><EmbeddedResource Include="../guia-stardew/dist/acquisition.js" LogicalName="Guide.acquisition.js" /></ItemGroup><ItemGroup><EmbeddedResource Include="../guia-stardew/dist/profile.js" LogicalName="Guide.profile.js" /></ItemGroup><ItemGroup><EmbeddedResource Include="../guia-stardew/dist/time-format.js" LogicalName="Guide.time-format.js" /></ItemGroup></Project>
