<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StardewRealtimeTelemetry</AssemblyName>
    <RootNamespace>StardewRealtimeTelemetry</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>pickaxe_icon.ico</ApplicationIcon>
    <GuideDistDir Condition="'$(GuideDistDir)' == ''">$(MSBuildProjectDirectory)/../guia-stardew/dist</GuideDistDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
    <GuideFile Include="index.html;telemetry.js;realtime.js;embedded.js;visual.js;knowledge.js;polish.js;acquisition.js;profile.js;time-format.js" />
    <EmbeddedResource Include="@(GuideFile->'$(GuideDistDir)/%(Identity)')" LogicalName="Guide.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ValidateGuideFiles" BeforeTargets="PrepareResourceNames">
    <Error Condition="!Exists('$(GuideDistDir)/%(GuideFile.Identity)')" Text="Arquivo do guia ausente: $(GuideDistDir)/%(GuideFile.Identity). Informe a pasta dist do guia com -p:GuideDistDir=&lt;caminho&gt;. Consulte o README." />
  </Target>
</Project>
