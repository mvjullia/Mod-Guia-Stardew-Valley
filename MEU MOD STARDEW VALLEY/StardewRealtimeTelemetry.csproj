<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StardewRealtimeTelemetry</AssemblyName>
    <RootNamespace>StardewRealtimeTelemetry</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>pickaxe_icon.ico</ApplicationIcon>
    <!-- Paths may be overridden with -p:GuideSourceDir=... and -p:GuideAssetsDir=... -->
    <GuideSourceDir Condition="'$(GuideSourceDir)' == ''">$(MSBuildProjectDirectory)/guide-src</GuideSourceDir>
    <GuideAssetsDir Condition="'$(GuideAssetsDir)' == '' and '$(GuideDistDir)' != ''">$(GuideDistDir)</GuideAssetsDir>
    <GenerateGuideAssets Condition="'$(GenerateGuideAssets)' == '' and '$(GuideDistDir)' != ''">false</GenerateGuideAssets>
    <GuideAssetsDir Condition="'$(GuideAssetsDir)' == ''">$(MSBuildProjectDirectory)/obj/guide-dist</GuideAssetsDir>
    <GenerateGuideAssets Condition="'$(GenerateGuideAssets)' == ''">true</GenerateGuideAssets>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
  </ItemGroup>

  <!-- This is the manifest of files and exact embedded resource names used by EmbeddedGuide. -->
  <ItemGroup>
    <GuideFile Include="index.html;telemetry.js;realtime.js;embedded.js;visual.js;knowledge.js;polish.js;acquisition.js;profile.js;time-format.js;item-catalog.js;item-fields.json;items.json;game-ui.js;game-cursor.png;menu-hover.wav;menu-select.wav;menu-open.wav;menu-close.wav;game-ui-sources.json;season.js;season-guide.json" />
    <GuideFile Include="albums.js;album-moments.json;Pixellari.ttf;community-center.png;community-center-mask.png" />
    <EmbeddedResource Include="@(GuideFile->'$(GuideAssetsDir)/%(Identity)')">
      <LogicalName>Guide.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PrepareGuideAssets" BeforeTargets="PrepareForBuild;AssignTargetPaths">
    <Error Condition="'$(GenerateGuideAssets)' != 'true' and '$(GenerateGuideAssets)' != 'false'"
           Text="GenerateGuideAssets deve ser true ou false." />
    <ItemGroup Condition="'$(GenerateGuideAssets)' == 'true'">
      <_GuideSource Include="@(GuideFile->'$(GuideSourceDir)/%(Identity)')" />
    </ItemGroup>
    <Error Condition="'$(GenerateGuideAssets)' == 'true' and !Exists('%(_GuideSource.Identity)')"
           Text="Arquivo-fonte do guia ausente: %(_GuideSource.Identity). Restaure guide-src ou configure GuideSourceDir; consulte README.md." />
    <MakeDir Directories="$(GuideAssetsDir)" Condition="'$(GenerateGuideAssets)' == 'true'" />
    <Copy SourceFiles="@(_GuideSource)" DestinationFiles="@(GuideFile->'$(GuideAssetsDir)/%(Identity)')"
          SkipUnchangedFiles="true" Condition="'$(GenerateGuideAssets)' == 'true'" />
    <ItemGroup>
      <_GuideAsset Include="@(GuideFile->'$(GuideAssetsDir)/%(Identity)')" />
    </ItemGroup>
    <Error Condition="!Exists('%(_GuideAsset.Identity)')"
           Text="Arquivo do guia ausente: %(_GuideAsset.Identity). Gere os arquivos com PrepareGuideAssets ou informe GuideAssetsDir válido; consulte README.md." />
  </Target>
</Project>
